# Algorhythm full-stack — переменные для инфраструктуры
# Скопируйте в .env и настройте под окружение

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# PostgreSQL (control-plane)
POSTGRES_USER=algorhythm
POSTGRES_PASSWORD=algorhythm
POSTGRES_DB=control_plane

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# NATS — без auth по умолчанию для dev
# Qdrant — без auth по умолчанию для dev
